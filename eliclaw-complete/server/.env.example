NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# JWT
JWT_SECRET=CHANGE_ME

# WordPress Bridge
WP_API_KEY=CHANGE_ME
AGENCY_DOMAIN=virtualabdigital.com
ELICLAW_DOMAIN=eliclaw.virtualabdigital.com

# Google PageSpeed Insights (Free: https://developers.google.com/speed/docs/insights/v5/get-started)
PAGESPEED_API_KEY=CHANGE_ME

# Ahrefs API (Paid: https://ahrefs.com/api)
AHREFS_API_KEY=CHANGE_ME

# SEMrush API (Paid: https://www.semrush.com/api.html)
SEMRUSH_API_KEY=CHANGE_ME

# Moz API (Paid: https://moz.com/products/api)
MOZ_API_KEY=CHANGE_ME

# Email - Choose one provider
EMAIL_PROVIDER=resend

# Resend (Recommended - https://resend.com)
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=noreply@eliclaw.virtualabdigital.com
FROM_NAME=EliClaw by Virtualab Digital

# SendGrid (Alternative - https://sendgrid.com)
SENDGRID_API_KEY=your_sendgrid_api_key

# SMTP Fallback
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_STARTER_PRICE_ID=price_your_starter_price_id
STRIPE_PRO_PRICE_ID=price_your_pro_price_id
STRIPE_AGENCY_PRICE_ID=price_your_agency_price_id

# Admin
ADMIN_EMAIL=admin@virtualabdigital.com
ADMIN_NAME=Virtualab Digital Team