# ─── Eli MicroSaaS — Production Environment Variables ───
#
# Copy this to .env on your production server and fill in values.
# NEVER commit .env to git.

# Database (SQLite — file path on the server)
DATABASE_URL=file:/opt/eli/data/custom.db

# Knowledge base directory (absolute path on the server)
KNOWLEDGE_DIR=/opt/eli/data/uploads/knowledge-sources

# Keyword research data directory
KEYWORD_DIR=/opt/eli/data/keyword-research

# Optional: restrict to a specific port (default 3000)
PORT=3000

# ─── LLM Backend ───
# Primary: Google Gemini (recommended for production)
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fallback: z-ai-web-dev-sdk (only works inside Z sandbox)
# No config needed — auto-detected

# ─── Eli Introduction Video ───
# Set to a YouTube/Vimeo embed URL to show Eli's intro video
ELI_INTRO_VIDEO_URL=
