# Eli Claw Environment Variables Configuration
# DO NOT COMMIT THIS FILE WITH REAL VALUES
# Copy this to .env and fill in your actual values
# For production, use separate files: .env.app, .env.database, .env.queue, .env.storage, .env.providers, .env.moderation, .env.notifications

# ============================================
# Application Settings
# ============================================
APP_NAME=Eli Claw
APP_VERSION=0.2.0
ENVIRONMENT=development
SECRET_KEY=your-super-secret-key-change-in-production
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
LOG_LEVEL=INFO

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql+psycopg://eliclaw:eliclaw_password@postgres:5432/eliclaw
POSTGRES_USER=eliclaw
POSTGRES_PASSWORD=eliclaw_password
POSTGRES_DB=eliclaw
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================
# Queue Configuration (Celery + Redis)
# ============================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=[json]
CELERY_TIMEZONE=UTC

# ============================================
# Storage Configuration
# ============================================
MEDIA_STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/storage/media
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eliclaw-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# ============================================
# Provider API Keys (REQUIRED FOR PRODUCTION)
# IMPORTANT: Never commit real API keys to version control
# ============================================
OPENAI_API_KEY=
STABILITY_API_KEY=sk-your-stability-ai-key-here
RUNWAY_API_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=
GOOGLE_VERTEX_PROJECT_ID=
GOOGLE_VERTEX_LOCATION=us-central1

MEDIA_PROVIDER_DEFAULT=stability

# ============================================
# Moderation Configuration
# ============================================
MODERATION_ENABLED=true
MODERATION_PROVIDER=rule_based
OPENAI_MODERATION_API_KEY=
BLOCK_UNSAFE_PROMPTS=true
REQUIRE_ADMIN_REVIEW=false

# ============================================
# Notifications & Webhooks
# ============================================
WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret-change-this
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT_SECONDS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=noreply@eliclaw.com

# ============================================
# Usage Limits
# ============================================
MAX_MEDIA_JOBS_PER_MONTH=1000
MAX_BATCH_ITEMS_PER_MONTH=5000
MAX_STORAGE_GB=100
MAX_WEBHOOK_DELIVERIES_PER_MONTH=10000
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# Stripe (for future billing)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
